# ---- Front-end (Vercel / local) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Opcional: rótulo do ambiente exibido na UI
NEXT_PUBLIC_APP_ENV=demo

# ---- Edge Functions (supabase secrets set ...) ----
# ANTHROPIC_API_KEY=<chave>            # ausente => modo degradado por regras
# ANTHROPIC_MODEL=claude-haiku-4-5     # modelo configurável por ambiente
# PRESENTER_SECRET=<código do apresentador>  # protege /demo
# DAILY_BUDGET_USD=2
# ROOM_LLM_CALL_LIMIT=50
# LLM_COOLDOWN_SECONDS=15
# LLM_MIN_NEW_MESSAGES=3
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo Supabase

# ---- Testes E2E (Playwright) ----
# E2E_BASE_URL=http://localhost:3000
# E2E_PRESENTER_SECRET=<mesmo valor de PRESENTER_SECRET>
